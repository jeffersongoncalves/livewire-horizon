{
    "name": "jeffersongoncalves/livewire-horizon",
    "description": "A Livewire + Flux rewrite of the Laravel Horizon dashboard, with bulk actions, supervisor controls, queue clearing and search.",
    "keywords": [
        "laravel",
        "livewire",
        "horizon",
        "flux",
        "queue",
        "dashboard"
    ],
    "homepage": "https://github.com/jeffersongoncalves/livewire-horizon",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0",
        "laravel/horizon": "^5.0",
        "livewire/livewire": "^3.7.4",
        "livewire/flux": "^2.0",
        "livewire/flux-pro": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LivewireHorizon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LivewireHorizon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LivewireHorizon\\LivewireHorizonServiceProvider"
            ],
            "aliases": {
                "LivewireHorizon": "JeffersonGoncalves\\LivewireHorizon\\Facades\\LivewireHorizon"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
